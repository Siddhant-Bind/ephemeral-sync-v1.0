# Reference for all deployment settings. This file is not loaded automatically.
# Set backend values on Render and the frontend value on Vercel.

# API server (Render)
NODE_ENV=production
CORS_ORIGIN=https://your-project.vercel.app
REDIS_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=ephemeral-uploads
# Render automatically sets RENDER_EXTERNAL_URL; you can also override it:
# KEEP_ALIVE_URL=https://your-api.onrender.com

# Frontend (Vercel; public URL, not a secret)
VITE_API_BASE_URL=https://your-api.onrender.com

# Local API defaults (only if you set variables manually when running locally)
# PORT=5000
# TEST_MOCK_STORAGE=true
