# API server settings. This example is documentation; the API does not load it
# automatically. Set these in your shell for local runs or in Render's service
# Environment settings for production.

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Use a Redis-protocol URL (redis:// or rediss://), not an HTTP REST URL/token.
REDIS_URL=

# Azure Storage account connection string. Keep this secret.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=ephemeral-uploads

# Local-only option: true uses temporary in-memory storage; do not use in production.
TEST_MOCK_STORAGE=false
