# Vite frontend settings. Copy to .env in this folder for local development;
# Vite loads this folder's .env files automatically. VITE_* values are public.

# Leave blank locally to use the Vite proxy to http://localhost:5000.
# For a deployed build, set this to the public API URL with no trailing slash.
VITE_API_BASE_URL=

# Local Vite server options (defaults shown)
PORT=5173
BASE_PATH=/
VITE_DEV_API_PROXY=http://localhost:5000
